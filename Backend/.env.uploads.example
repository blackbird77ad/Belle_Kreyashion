# Maximum size of each lesson or digital-product file accepted by the API.
DIGITAL_UPLOAD_MAX_MB=1024

# Cloudinary requires chunks of at least 5 MB. Its default and our default are 20 MB.
CLOUDINARY_UPLOAD_CHUNK_MB=20

# Allow enough time for the browser upload and the following Cloudinary transfer.
SERVER_REQUEST_TIMEOUT_MS=1800000
