# Google Cloud OAuth 2.0 Web application credentials.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Must exactly match an Authorized redirect URI in Google Cloud Console.
YOUTUBE_OAUTH_REDIRECT_URI=https://your-api.example.com/api/youtube/oauth/callback

# Long random secret used to encrypt the stored YouTube refresh token.
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Used to build the default OAuth callback when YOUTUBE_OAUTH_REDIRECT_URI is omitted.
BACKEND_PUBLIC_URL=https://your-api.example.com

# OAuth completion returns the admin to this site.
FRONTEND_URL=https://your-site.example.com
