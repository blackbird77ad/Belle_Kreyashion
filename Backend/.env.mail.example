# Copy the keys you need into Backend/.env and fill them with your real SMTP provider values.

# Resend option
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="Your Brand <sender@yourdomain.com>"
# CUSTOMER_FROM_EMAIL="Belle Kreyashon <hello@yourdomain.com>"
# CONTACT_FROM_EMAIL="Belle Kreyashon <hello@yourdomain.com>"
# CONTACT_TO_EMAIL="hello@yourdomain.com"
# Optional:
# RESEND_REPLY_TO=blackbird77ad@gmail.com
# CERTIFICATE_SHARE_SECRET=use-a-long-random-secret-Just-As-Iam-doingit-in-oh-mean-onThisLine
# CERTIFICATE_SHARE_EXPIRES_IN=14d

# SMTP fallback option
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
SMTP_FROM="Your Brand <noreply@yourdomain.com>"
# CUSTOMER_FROM_EMAIL="Belle Kreyashon <hello@yourdomain.com>"
# CONTACT_FROM_EMAIL="Belle Kreyashon <hello@yourdomain.com>"
# CONTACT_TO_EMAIL="hello@yourdomain.com"
CERTIFICATE_FROM_EMAIL="Your Brand <sender@yourdomain.com>"
